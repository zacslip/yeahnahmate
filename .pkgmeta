# BigWigs packager (https://github.com/BigWigsMods/packager). The addon lives in YeahNahMate/ inside
# the repo; the zip holds just that folder. QuestieDB is an optional dependency, not included.
# The libraries are already in YeahNahMate/libs (no externals).
package-as: YeahNahMate

optional-dependencies:
  - questiedb

move-folders:
  YeahNahMate/YeahNahMate: YeahNahMate

ignore:
  - tests
  - tools
  - README.md
  - CONTRIBUTING.md
  - SECURITY.md
  - docs
  - .github
  - .editorconfig
  - .luacheckrc
  - .gitattributes
  - .gitignore

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
